{
  "name": "claude-style-deepseek",
  "version": "1.6.0",
  "description": "Claude Code colors and transcript flow for DeepSeek Harness: warm palette, live thinking window, one-line tool calls and collapsible step summaries.",
  "type": "module",
  "license": "MIT",
  "author": "devopshelper",
  "homepage": "https://github.com/devopshelper/claude-style-deepseek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devopshelper/claude-style-deepseek.git"
  },
  "bugs": {
    "url": "https://github.com/devopshelper/claude-style-deepseek/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "claude",
    "claude-code",
    "terminal",
    "web-ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
